# Required for the Add Extension upload flow (/admin/upload) to commit
# extracted archives to GitHub — create a fine-grained or classic personal
# access token with write access to the repo below, then set this in your
# Vercel project's Environment Variables (or a local .env for `npm run dev`).
GITHUB_TOKEN=

# Defaults shown below — override only if you fork/rename the repo or want
# uploads to land on a different branch.
GITHUB_REPO=electricplatypus/Rydr-Extensions
GITHUB_BRANCH=main
