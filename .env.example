# Required for the Add Extension upload flow (/admin/upload) to commit
# extracted archives to GitHub — create a fine-grained or classic personal
# access token with write access to the repo below, then set this in your
# Vercel project's Environment Variables (or a local .env for `npm run dev`).
GITHUB_TOKEN=

# Defaults shown below — override only if you fork/rename the repo or want
# uploads to land on a different branch.
GITHUB_REPO=electricplatypus/Rydr-Extensions
GITHUB_BRANCH=main

# Required to use this app's own /admin section at all (route approvals,
# item CRUD, uploads) — middleware.ts requires it as an HTTP Basic Auth
# password on every /admin page and write API call. Also independently
# gates POST /api/route-maps/direct-add (a route submission that skips PR
# review and commits straight to main), via its own X-Admin-Token header
# check — enter the same value once into RydR's Route Sources screen to use
# that. Leave unset to keep /admin and direct-add both disabled (401/503).
ROUTE_MAPS_ADMIN_TOKEN=
